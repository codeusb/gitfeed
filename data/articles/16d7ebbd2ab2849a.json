  "coverImage": "https://raw.githubusercontent.com/showerberich/editable-ppt-materials/main/materials/%E7%A7%91%E7%A0%94%E5%AD%A6%E6%9C%AF/25_%E5%9B%BA%E6%80%81%E7%94%B5%E8%A7%A3%E8%B4%A8%E6%9D%90%E6%96%99%E6%9C%BA%E7%90%86%E6%A8%A1%E5%9E%8B%E5%9B%BE%E8%83%BD%E6%BA%90%E7%A7%91%E7%A0%94PPT/%E5%8E%9F%E5%9B%BE.jpg",
