  "coverImage": "https://raw.githubusercontent.com/showerberich/editable-ppt-materials/main/materials/%E7%A7%91%E7%A0%94%E5%AD%A6%E6%9C%AF/01_%E6%96%B0%E6%8B%9F%E6%80%81%E9%A3%8E%E7%A0%94%E7%A9%B6%E6%A1%86%E6%9E%B6%E7%BB%93%E6%9E%84%E7%94%9F%E7%89%A9%E5%8C%BB%E5%AD%A6PPT/%E5%8E%9F%E5%9B%BE.jpg",
