  "coverImage": "https://raw.githubusercontent.com/showerberich/editable-ppt-materials/main/materials/%E5%B9%B4%E7%BB%88%E6%80%BB%E7%BB%93/003_%E5%B9%B4%E7%BB%88%E6%80%BB%E7%BB%93%E6%95%B0%E6%8D%AE%E5%8F%AF%E8%A7%86%E5%8C%96PPT%E6%A8%A1%E6%9D%BF_p01/%E5%8E%9F%E5%9B%BE.jpg",
